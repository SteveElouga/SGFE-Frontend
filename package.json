{
  "name": "sgfe-frontend",
  "version": "0.0.0",
  "scripts": {
    "build": "ng build",
    "ng": "ng",
    "start": "ng serve",
    "test": "ng test",
    "watch": "ng build --watch --configuration development",
    "codegen": "graphql-codegen --config codegen.ts",
    "e2e": "playwright test",
    "verify": "npm run verify:types && npm run verify:codegen && npm run verify:jointure && npm run verify:ui",
    "verify:codegen": "node scripts/verifier-codegen.mjs",
    "verify:defilement": "node scripts/verifier-defilement-pages.mjs",
    "verify:jointure": "node scripts/verifier-jointure-api.mjs",
    "verify:liens": "node scripts/verifier-liens-routes.mjs",
    "verify:types": "tsc -b --noEmit",
    "verify:ui": "npm run verify:defilement && npm run verify:liens"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/animations": "^22.0.4",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/service-worker": "^22.0.0",
    "@apollo/client": "^4.2.3",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@primeuix/themes": "^2.0.3",
    "apollo-angular": "^14.1.0",
    "graphql": "^16.14.2",
    "graphql-ws": "^6.0.8",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.4",
    "@angular/cli": "^22.0.4",
    "@angular/compiler-cli": "^22.0.0",
    "@graphql-codegen/cli": "^7.3.1",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
