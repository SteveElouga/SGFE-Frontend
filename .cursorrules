## ARCHITECTURE ANGULAR 22

### Structure des composants

```typescript
// ✅ BON — Composant Angular 22 complet
import { Component, signal, computed, inject, OnInit } from '@angular/core';
import { CommonModule } from '@angular/common';
import { Apollo } from 'apollo-angular';

@Component({
  standalone: true,
  imports: [CommonModule],
  template: `
    @if (loading()) {
      <app-loading />
    } @else if (error()) {
      <app-error-message [message]="error()!" />
    } @else {
      <div class="liste">
        @for (item of items(); track item.id) {
          <div class="item">{{ item.nom }}</div>
        }
      </div>
    }
  `,
})
export class MonComposant implements OnInit {
  private apollo = inject(Apollo);

  // Signals
  items = signal<MonType[]>([]);
  loading = signal(false);
  error = signal<string | null>(null);

  // Computed
  nbItems = computed(() => this.items().length);

  ngOnInit(): void {
    this.charger();
  }

  private charger(): void {
    this.loading.set(true);
    this.error.set(null);
    // appel Apollo...
  }
}
```

### Formulaires avec Signal Forms

```typescript
// ✅ BON — Signal Forms Angular 22
import { signalForm, signalInput, required, min } from '@angular/forms';

@Component({ standalone: true, template: `...` })
export class SaisirIndexComponent {
  form = signalForm({
    nouveauIndex: signalInput<number>({
      validators: [required(), min(0)],
    }),
    observation: signalInput<string | null>({ initialValue: null }),
  });

  soumettre(): void {
    if (!this.form.valid()) return;
    const valeurs = this.form.value();
    // traitement...
  }
}

// ❌ MAUVAIS — NE PAS UTILISER
import { FormBuilder, ReactiveFormsModule } from '@angular/forms';
// ReactiveFormsModule est obsolète en Angular 22
```

### Injection de dépendances

```typescript
// ✅ BON — inject() dans Angular 22
export class MonService {
  private apollo = inject(Apollo);
  private auth = inject(AuthService);
  private router = inject(Router);
}

// ❌ MAUVAIS — constructeur (ancienne façon)
export class MonService {
  constructor(private apollo: Apollo) {}
}
```

### Syntax des templates Angular 22

```html
<!-- ✅ BON — Nouvelle syntax @if @for @switch (Angular 22) -->
@if (isLoading()) {
  <app-spinner />
} @else if (hasError()) {
  <p class="erreur">{{ errorMessage() }}</p>
} @else {
  @for (abonne of abonnes(); track abonne.id) {
    <app-abonne-card [abonne]="abonne" />
  } @empty {
    <p>Aucun abonné trouvé</p>
  }
}

<!-- ❌ MAUVAIS — Ancienne syntax (Angular < 17) -->
<div *ngIf="isLoading">...</div>
<div *ngFor="let abonne of abonnes">...</div>
```

