# .env.example — Frontend Angular 22
# Système de Gestion de Facturation d'Eau
#
# INSTRUCTIONS :
#   1. Copier : cp .env.example .env
#   2. Remplir les valeurs [À_CONFIGURER]
#   3. Ne JAMAIS committer .env dans Git
#
# NOTE : Angular utilise les fichiers src/environments/*.ts
#        Ce .env est utilisé par le processus de build (ng build)
#        via @ngx-env/builder ou des variables d'environnement système

# =============================================
# API GATEWAY
# =============================================

# URL de l'API GraphQL Gateway
# Développement local
NG_APP_GRAPHQL_URL=http://localhost:8000/graphql

# Production (ngrok)
# NG_APP_GRAPHQL_URL=https://[VOTRE_URL_NGROK]/graphql

# URL de base de l'application (pour les liens tokenisés)
NG_APP_BASE_URL=http://localhost:4200

# =============================================
# CONFIGURATION APPLICATION
# =============================================

# Nom de l'application (affiché dans le titre)
NG_APP_NAME=Facturation Eau

# Version de l'application
NG_APP_VERSION=1.0.0

# Environnement : development | staging | production
NG_APP_ENVIRONMENT=development

# =============================================
# APOLLO CLIENT
# =============================================

# Timeout des requêtes GraphQL (en millisecondes)
NG_APP_GRAPHQL_TIMEOUT=30000

# Activer le cache Apollo : true | false
NG_APP_GRAPHQL_CACHE=true

# =============================================
# PWA
# =============================================

# Nom court pour l'écran d'accueil du smartphone
NG_APP_PWA_SHORT_NAME=Eau

# Couleur du thème PWA (barre de status mobile)
NG_APP_PWA_THEME_COLOR=#1976d2

# =============================================
# FONCTIONNALITÉS (feature flags)
# =============================================

# Activer le mode hors-ligne (cache Service Worker)
NG_APP_OFFLINE_MODE=true

# Activer les logs de débogage Apollo
NG_APP_APOLLO_DEV_TOOLS=true

# Activer l'affichage des traces OpenTelemetry dans la console
NG_APP_OTEL_DEBUG=false

# =============================================
# CORRESPONDANCE AVEC src/environments/
# =============================================
#
# Ces variables alimentent les fichiers d'environnement Angular :
#
# src/environments/environment.ts (développement) :
#   export const environment = {
#     production: false,
#     graphqlUrl: 'http://localhost:8000/graphql',
#     appName: 'Facturation Eau',
#   };
#
# src/environments/environment.prod.ts (production) :
#   export const environment = {
#     production: true,
#     graphqlUrl: 'https://[URL_NGROK]/graphql',
#     appName: 'Facturation Eau',
#   };
#
# =============================================
# COMMANDES DE BUILD
# =============================================
#
# Développement :
#   ng serve --configuration development
#
# Production :
#   ng build --configuration production
#
# Build PWA + Service Worker :
#   ng build --configuration production
#   → dist/ contient le Service Worker généré
