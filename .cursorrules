## TESTS — VITEST (défaut Angular 22)

```typescript
// ✅ BON — Test avec Vitest
import { describe, it, expect, vi } from 'vitest';
import { TestBed } from '@angular/core/testing';

describe('CampagneService', () => {
  it('doit calculer la consommation correctement', () => {
    const consommation = calculerConsommation(100, 115);
    expect(consommation).toBe(15);
  });

  it('doit rejeter si nouveau index inférieur à ancien', () => {
    expect(() => calculerConsommation(200, 100)).toThrow();
  });
});

