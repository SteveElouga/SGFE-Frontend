# PrimeNG 21 déclare un peer @angular/common@^21 alors que le projet est en
# Angular 22 (PrimeNG 21 fonctionne au runtime sur Angular 22). Sans cette
# option, `npm ci` strict échoue en ERESOLVE et casse le CI/CD.
# legacy-peer-deps aligne CI, CD et local sur le comportement d'installation réel.
legacy-peer-deps=true
