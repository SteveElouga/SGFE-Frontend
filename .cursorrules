## GRAPHQL — PATTERNS OBLIGATOIRES

### Définition des queries

```typescript
// ✅ BON — Query GraphQL typée
import { gql } from '@apollo/client/core';
import { TypedDocumentNode } from '@apollo/client/core';

interface GetAbonnesData {
  abonnes: Abonne[];
}
interface GetAbonnesVariables {
  statut?: StatutAbonne;
}

export const GET_ABONNES: TypedDocumentNode<GetAbonnesData, GetAbonnesVariables> = gql`
  query GetAbonnes($statut: StatutAbonne) {
    abonnes(statut: $statut) {
      id
      numeroAbonne
      nom
      prenom
      telephoneWhatsapp
      statut
      compteur {
        numeroCompteur
        quartier
        camp
      }
    }
  }
`;
```

### Utilisation Apollo avec Signals

```typescript
// ✅ BON — Pattern Apollo + Signals complet
export class AbonnesComponent implements OnInit {
  private apollo = inject(Apollo);

  abonnes = signal<Abonne[]>([]);
  loading = signal(false);
  error = signal<string | null>(null);

  ngOnInit(): void { this.chargerAbonnes(); }

  chargerAbonnes(): void {
    this.loading.set(true);
    this.apollo
      .watchQuery({ query: GET_ABONNES })
      .valueChanges
      .subscribe({
        next: ({ data, loading }) => {
          this.abonnes.set(data.abonnes);
          this.loading.set(loading);
        },
        error: (err) => {
          this.error.set('Impossible de charger les abonnés');
          this.loading.set(false);
          console.error(err);
        },
      });
  }

  executerMutation(input: SaisirIndexInput): void {
    this.apollo.mutate({
      mutation: SAISIR_INDEX,
      variables: { input },
      // Mettre à jour le cache Apollo après mutation
      refetchQueries: [{ query: GET_PROGRESSION, variables: { campagneId: input.campagneId } }],
    }).subscribe({
      next: () => { /* succès */ },
      error: () => { this.error.set('Erreur lors de la saisie'); },
    });
  }
}
```

