## GESTION DES RÔLES — PATTERNS

### Guard de rôle

```typescript
// core/auth/role.guard.ts
import { inject } from '@angular/core';
import { CanActivateFn, Router } from '@angular/router';
import { AuthService } from './auth.service';

export function roleGuard(roles: Role[]): CanActivateFn {
  return () => {
    const auth = inject(AuthService);
    const router = inject(Router);

    if (roles.includes(auth.role()!)) return true;

    router.navigate(['/non-autorise']);
    return false;
  };
}
```

### Affichage conditionnel par rôle dans les templates

```typescript
// ✅ BON — Signal pour le rôle dans le template
@Component({
  template: `
    @if (auth.isAdmin()) {
      <button (click)="cloturerCampagne()">Clôturer</button>
    }
    @if (auth.isAgent()) {
      <button (click)="saisirIndex()">Saisir Index</button>
    }
  `
})
export class CampagneComponent {
  auth = inject(AuthService);
}
```

